{
  "name": "nexo-filmes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catálogo de filmes com React 19, TypeScript e micro-frontends.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:shell": "npm run dev --workspace @nexo/shell",
    "dev:catalog": "npm run dev --workspace @nexo/catalog",
    "dev:movie": "npm run dev --workspace @nexo/movie",
    "dev:area": "npm run dev --workspace @nexo/area",
    "dev:bff": "npm run dev --workspace @nexo/bff",
    "start:bff": "node dist/bff/server.js",
    "build": "npm run build --workspaces --if-present",
    "preview": "node scripts/dev.mjs --preview",
    "typecheck": "tsc --noEmit",
    "architecture": "node scripts/check-architecture.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev --port 6006 --host 127.0.0.1 --no-open --disable-telemetry --exact-port",
    "build:storybook": "storybook build --disable-telemetry",
    "test:storybook": "vitest run --project storybook",
    "check": "npm run architecture && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@module-federation/runtime": "2.9.2",
    "axios": "1.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "styled-components": "6.5.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@module-federation/vite": "1.23.4",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^16.0.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
