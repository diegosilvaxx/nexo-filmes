# Endereços públicos dos remotes. Resolvidos pelo Shell em runtime.
NEXO_CATALOG_REMOTE_URL=http://127.0.0.1:4101/remoteEntry.js
NEXO_MOVIE_REMOTE_URL=http://127.0.0.1:4102/remoteEntry.js
NEXO_AREA_REMOTE_URL=http://127.0.0.1:4103/remoteEntry.js

# API Read Access Token. Utilizado somente no servidor.
TMDB_READ_ACCESS_TOKEN=
BFF_PORT=4200
BFF_HOST=127.0.0.1

# Destino do proxy /api nos servidores Vite.
NEXO_BFF_URL=http://127.0.0.1:4200

# Endereço do portal para links entre aplicações na execução independente.
VITE_PORTAL_URL=http://127.0.0.1:4100

# Simulação do repositório local. Em testes, atrasos e falhas ficam desativados.
VITE_USER_DATA_DELAY_MIN_MS=300
VITE_USER_DATA_DELAY_MAX_MS=1500
VITE_USER_DATA_FAIL_WRITES=true
