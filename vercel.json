{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "shell": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci --include=dev --workspaces --include-workspace-root",
      "buildCommand": "node scripts/build-vercel.mjs shell",
      "outputDirectory": "dist/vercel/shell",
      "routes": [{ "handle": "filesystem" }, { "src": "/(.*)", "dest": "/index.html" }]
    },
    "catalog": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci --include=dev --workspaces --include-workspace-root",
      "buildCommand": "node scripts/build-vercel.mjs catalog",
      "outputDirectory": "dist/vercel/catalog",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/remotes/catalog/index.html" }
      ]
    },
    "movie": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci --include=dev --workspaces --include-workspace-root",
      "buildCommand": "node scripts/build-vercel.mjs movie",
      "outputDirectory": "dist/vercel/movie",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/remotes/movie/index.html" }
      ]
    },
    "area": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npm ci --include=dev --workspaces --include-workspace-root",
      "buildCommand": "node scripts/build-vercel.mjs area",
      "outputDirectory": "dist/vercel/area",
      "routes": [{ "handle": "filesystem" }, { "src": "/(.*)", "dest": "/remotes/area/index.html" }]
    },
    "bff": {
      "root": ".",
      "framework": "node",
      "entrypoint": "apps/bff/src/vercel.ts",
      "installCommand": "npm ci --include=dev --workspaces --include-workspace-root",
      "buildCommand": "npm run typecheck",
      "outputDirectory": "."
    }
  },
  "headers": [
    {
      "source": "/runtime-config.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/remotes/:name/remoteEntry.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "bff" } },
    { "source": "/remotes/catalog", "destination": { "service": "catalog" } },
    { "source": "/remotes/movie", "destination": { "service": "movie" } },
    { "source": "/remotes/area", "destination": { "service": "area" } },
    {
      "source": "/remotes/catalog/:path*",
      "destination": { "service": "catalog" }
    },
    {
      "source": "/remotes/movie/:path*",
      "destination": { "service": "movie" }
    },
    {
      "source": "/remotes/area/:path*",
      "destination": { "service": "area" }
    },
    { "source": "/(.*)", "destination": { "service": "shell" } }
  ]
}
