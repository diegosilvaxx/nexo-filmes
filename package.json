{
  "name": "nexo-filmes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catálogo de filmes com React 19, TypeScript e micro-frontends.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:shell": "npm run dev --workspace @nexo/shell",
    "dev:catalog": "npm run dev --workspace @nexo/catalog",
    "dev:movie": "npm run dev --workspace @nexo/movie",
    "dev:area": "npm run dev --workspace @nexo/area",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace @nexo/shell",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "axios": "1.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "^16.0.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
